+}
+
+function AssignedTeam({
+  team,
+  agentRegistry,
+  modelProfiles,
+  modelRegistry,
+  modelRoutes,
+  modelRoutesPersisted,
+  selecting,
+  routingModels,
+  onSelectTeam,
+  onPreviewModelRoutes,
+  onPersistModelRoutes,

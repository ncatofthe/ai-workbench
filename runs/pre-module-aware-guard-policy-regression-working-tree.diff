+    for line in lines:
+        stripped = line.strip()
+        if stripped.startswith("#"):
+            normalized = stripped.lstrip("#").strip().lower()
+            if in_section:
+                break
+            if heading in normalized:
+                in_section = True
+            continue
+        if in_section:
+            section.append(line)
+    return "\n".join(section).strip()

+  team: RunAgentAssignment[];
+  agentRegistry: AgentInfo[];
+  modelProfiles: ModelProfile[];
+  modelRegistry: ModelRegistryItem[];
+  modelRoutes: ModelRouteDecision[];
+  modelRoutesPersisted: boolean;

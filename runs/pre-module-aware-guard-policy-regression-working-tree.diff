+}
+
+function ClarificationPanel({
+  questions,
+  savedAnswers,
+  answers,
+  saving,
+  regeneratingPlan,
+  onAnswersChange,
+  onSubmit,
+  onRegeneratePlan,
+}: {
+  questions?: string;
+  savedAnswers?: string;
+  answers: string;
+  saving: boolean;
+  regeneratingPlan: boolean;
